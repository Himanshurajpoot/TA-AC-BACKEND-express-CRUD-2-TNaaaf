<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css?v=2" />

  </head>
  <body>
 <header>
  <nav>
    <div class="brand">📚 Bookstore</div>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/books">Books</a></li>
      <li><a href="/books/new">Add Book</a></li>
    </ul>
  </nav>
</header>
    <form action="/books" method="post" enctype="multipart/form-data">
      <h2>Add Book</h2>
      <input type="text" name="title" placeholder="Title" />
      <textarea name="summary" rows="4" placeholder="Summary"></textarea>
      <input type="number" name="pages" placeholder="Pages" />
      <input type="text" name="publication" placeholder="Publication" />
      <input type="file" name="cover_image" placeholder="Cover Image" />
      <input type="text" name="category" placeholder="Category" />

      <h3>Author Info</h3>
      <input type="text" name="author[name]" placeholder="Author Name" />
      <input type="email" name="author[email]" placeholder="Author Email" />
      <input type="text" name="author[country]" placeholder="Author Country" />

       <input type="submit" value="Submit Book" />
    </form>
  </body>
</html>
