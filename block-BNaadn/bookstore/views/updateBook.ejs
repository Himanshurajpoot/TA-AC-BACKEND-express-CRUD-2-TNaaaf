<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css?v=2" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
</head>
<body>
    <header>
  <nav>
    <div class="brand">📚 Bookstore</div>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/books">Books</a></li>
      <li><a href="/books/new">Add Book</a></li>
    </ul>
  </nav>
</header>
    <form action="/books/<%=book.id%>" method="post" enctype="multipart/form-data">
      <h2>Update Book</h2>
      <input type="text" name="title" placeholder="Title" value="<%=book.title%>" />
<textarea name="summary" rows="4" placeholder="Summary"><%= book.summary %></textarea>

      <input type="number" name="pages" placeholder="Pages" value="<%=book.pages%>"/>
      <input type="text" name="publication" placeholder="Publication" value="<%=book.publication%>"/>
      <% if (book.cover_image) { %>
       <img src="/images/<%= book.cover_image %>" alt="Cover Image" style="max-width:150px; display:block; margin-bottom:10px;">
      <% } %>
      <input type="file" name="cover_image" />
      <input type="text" name="category" placeholder="Category" value="<%=book.category%>" />

      <h3>Author Info</h3>
      <input type="text" name="author[name]" placeholder="Author Name" value="<%=book.author.name%>"/>
      <input type="email" name="author[email]" placeholder="Author Email" value="<%=book.author.email%>"/>
      <input type="text" name="author[country]" placeholder="Author Country" value="<%=book.author.country%>"/>

       <input type="submit" value="Submit Book" />
    </form>
</body>
</html>